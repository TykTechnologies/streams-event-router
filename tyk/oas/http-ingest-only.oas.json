{
  "openapi": "3.0.3",
  "info": { "title": "HTTP Ingest (Streams)", "version": "1.0.0" },
  "paths": { "/inbound": { "post": { "responses": { "202": { "description": "Accepted" } } } } },
  "servers": [{ "url": "http://tyk-gateway:8282/events/" }],
  "x-tyk-api-gateway": {
    "info": { "name": "HTTP Ingest (Streams)", "state": { "active": true } },
    "server": { "listenPath": { "strip": true, "value": "/events/" } },
    "upstream": { "url": "" }
  },
  "x-tyk-streaming": {
    "allow_unsafe": ["http_server"],
    "streams": {
      "http_ingest": {
        "input": { "broker": { "inputs": [ { "http_server": { "path": "/inbound", "allowed_verbs": ["POST"], "timeout": "20s" } } ] } },
        "pipeline": {
          "processors": [
            { "switch": [
              { "check": "this.specversion.string().catch(\"\") != \"\"", "processors": [
                { "json_schema": { "schema": "{\"$schema\": \"http://json-schema.org/draft-07/schema#\", \"properties\": {\"data\": {\"type\": [\"object\", \"array\", \"string\", \"number\", \"boolean\", \"null\"]}, \"id\": {\"type\": \"string\"}, \"source\": {\"type\": \"string\"}, \"type\": {\"type\": \"string\"}}, \"required\": [\"id\", \"source\", \"type\"], \"type\": \"object\"}" } },
                { "mapping": "root.id = this.id.string()\nroot.source = this.source.string()\nroot.type = this.type.string().uppercase()\nroot.data = this.data\nroot.timestamp = now().ts_format(\\\"2006-01-02T15:04:05Z07:00\\\")\nmeta is_ce = \\\"true\\\"" }
              ] },
              { "processors": [ { "mapping": "meta is_ce = \"false\"" } ] }
            ] },
            { "switch": [
              { "check": "this.type.string().catch(\"\").uppercase() == \"BROADCAST_DEMO\"", "processors": [ { "mapping": "meta route_kafka = \"true\"\nmeta route_amqp = \"amqp_local\"\nmeta route_http = \"true\"" } ] },
              { "check": "this.type.string().catch(\"\").uppercase() == \"ORDER_CREATED\"", "processors": [ { "mapping": "meta route_kafka = \"true\"" } ] },
              { "check": "this.type.string().catch(\"\").uppercase() == \"USER_REGISTERED\"", "processors": [ { "mapping": "meta route_amqp = \"amqp_local\"" } ] },
              { "check": "this.type.string().catch(\"\").uppercase() == \"AUDIT_LOG\"", "processors": [ { "mapping": "meta route_http = \"true\"" } ] },
              { "processors": [ { "mapping": "meta route_http = meta(\"route_http\").or(\"true\")" } ] }
            ] }
          ], "threads": -1
        },
        "output": { "switch": { "retry_until_success": true, "strict_mode": false, "cases": [
          { "check": "meta(\"route_kafka\") == \"true\"", "continue": true,
            "output": { "kafka": { "addresses": ["labs-kafka:9092"], "max_in_flight": 64, "topic": "high-priority-topic" },
              "processors": [ { "mapping": "root.id = this.id.string().catch(uuid_v4())\nroot.source = this.source.string().catch(\\\"unknown\\\")\nroot.type = this.type.string().catch(\\\"UNKNOWN\\\").uppercase()\nroot.data = this.data.or(this)\nroot.timestamp = now().ts_format(\\\"2006-01-02T15:04:05Z07:00\\\")" }, { "protobuf": { "operator": "from_json", "message": "event.Event", "import_paths": ["/work/schemas"] } } ] } },
          { "check": "meta(\"route_amqp\") == \"amqp_local\"", "continue": true,
            "output": { "amqp_0_9": { "exchange": "", "key": "low-priority-queue", "max_in_flight": 64, "urls": ["amqp://guest:guest@rabbitmq:5672/"] } } },
          { "check": "meta(\"route_http\").or(\"false\") == \"true\"",
            "output": { "http_client": { "headers": { "Content-Type": "application/json" }, "max_in_flight": 64, "url": "http://demo:8080/events", "verb": "POST" },
              "processors": [ { "mapping": "root = this\nroot.type = this.type.or(\\\"unknown\\\")\nroot.route_hint = {\\\"kafka\\\": meta(\\\"route_kafka\\\").or(\\\"false\\\"), \\\"amqp\\\": meta(\\\"route_amqp\\\").or(\\\"\\\"), \\\"http\\\": meta(\\\"route_http\\\").or(\\\"false\\\") }" } ] } }
        ] } }
      }
    }
  }
}
